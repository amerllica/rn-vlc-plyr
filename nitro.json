{
  "cxxNamespace": ["rnvlcplyr"],
  "ios": {
    "iosModuleName": "RnVlcPlyr"
  },
  "android": {
    "androidNamespace": ["rnvlcplyr"],
    "androidCxxLibName": "rnvlcplyr"
  },
  "autolinking": {
    "VlcPlayer": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridVlcPlayer"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridVlcPlayer"
      }
    },
    "VlcPlayerView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridVlcPlayerView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridVlcPlayerView"
      }
    }
  },
  "ignorePaths": ["node_modules", "example", "example-expo", "example-shared"]
}
